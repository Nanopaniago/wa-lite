# Copie para .env e ajuste:  cp .env.example .env
PORT=3100
HOST=0.0.0.0

# Token para a interface e para a API (mínimo 12 caracteres).
# Gere um com:  openssl rand -hex 24
API_TOKEN=troque-por-um-token-grande

# Webhook geral do n8n (vazio = desativado). Cada cliente pode ter o seu na interface.
N8N_WEBHOOK_URL=
# Segredo opcional, enviado no header X-Webhook-Secret
WEBHOOK_SECRET=
# Enviar também ao n8n as mensagens enviadas por si?
WEBHOOK_FROM_ME=false
# Enviar mensagens de grupos ao n8n?
WEBHOOK_GROUPS=true

# Máximo de clientes (números de WhatsApp). Cada número ligado gasta memória extra.
MAX_SESSIONS=5

# Limites por cliente que mantêm o consumo de memória e disco baixo
MAX_CHATS=100
MAX_MSGS_PER_CHAT=150

# silent | error | info  (logs do Baileys)
LOG_LEVEL=silent
